# Everything is optional: without keys each feature runs in a labeled demo
# mode. Add a key and that feature switches to the real provider.

# Signs officer sessions and OTP tokens. REQUIRED in production.
AUTH_SECRET=

# Officer login (bcrypt hash, e.g. `npx bcrypt-cli hash 'yourpassword' 10`).
# Unset = demo account: oficial / caracas2026
OFFICER_USERNAME=
OFFICER_PASSWORD_HASH=

# Email OTP via Resend. Unset = code shown in the UI (demo).
RESEND_API_KEY=
VERIFY_EMAIL_FROM="VisaVenezuela <visa@example.gov.ve>"

# SMS OTP via Twilio. Unset = code shown in the UI (demo).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Visa fee payments via Stripe Checkout. Unset = inline demo payment sheet.
STRIPE_SECRET_KEY=

# Address autocomplete (Places API, restricted to Venezuela).
# Unset = plain text input.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
